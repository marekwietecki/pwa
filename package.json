{
  "name": "habit-bubbl",
  "version": "1.0.0",
  "description": "Habit Bubbl is a Progressive Web App (PWA) that turns daily responsibilities into an RPG adventure. Earn experience points (XP), level up your character, and track your habits through an interactive calendar.",
  "main": "sw.js",
  "private": "true",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_fe795f564e9d2e3",
    "build:css": "esbuild css/global.css css/index.css css/hero.css css/habits.css css/calendar.css --minify --outdir=css --entry-names=[name].min",
    "build:js": "esbuild js/ui.js --minify --format=esm --outdir=js --entry-names=[name].min",
    "build": "npm run build:css && npm run build:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marekwietecki/pwa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marekwietecki/pwa/issues"
  },
  "homepage": "https://github.com/marekwietecki/pwa#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "chromatic": "^18.7.1",
    "esbuild": "^0.28.2",
    "playwright": "latest",
    "storybook": "^10.5.10",
    "vitest": "latest"
  }
}
